# ---- Backend ---------------------------------------------------------------
# URL of the Conflux API + socket.io server.
REACT_APP_SERVER_URL=http://localhost:8000

# ---- TURN (optional, but required for reliable production calls) -----------
# Without TURN, WebRTC falls back to STUN only and fails behind symmetric NAT
# (many corporate and mobile networks). Free tiers: metered.ca, Twilio.
# REACT_APP_TURN_URL=turn:your-turn-host:3478
# REACT_APP_TURN_USERNAME=your-turn-username
# REACT_APP_TURN_CREDENTIAL=your-turn-credential
