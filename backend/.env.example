# Port the API + socket server listens on (hosts usually inject this)
PORT=8000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/conflux
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/conflux
MONGO_URI=mongodb://127.0.0.1:27017/conflux

# Allowed browser origin for CORS and socket.io.
# Use "*" locally; in production set your exact frontend URL.
CORS_ORIGIN=*

# ---- AI meeting summaries (optional) ---------------------------------------
# Without this key the app works normally; the summarise button is simply
# hidden and /api/v1/ai/status reports {"enabled": false}.
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
